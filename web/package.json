{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate": "orval",
    "sync-api": "cd .. && uv run export-openapi && uv run export-status-matrix && cd web && orval",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright-auth.config.ts",
    "test:e2e:audit": "playwright test --config playwright-audit.config.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/ && tsc",
    "lint:dead": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.1",
    "knip": "^6.38.0",
    "msw": "^2.15.0",
    "orval": "^8.38.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jalez/react-flow-smart-edge": "^4.0.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "eventsource-parser": "^4.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.4.0",
    "react-virtuoso": "^4.18.15",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
